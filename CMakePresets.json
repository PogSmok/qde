{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_PREFIX_PATH": "$env{CMAKE_PREFIX_PATH}"
      }
    },
    {
      "name": "default",
      "displayName": "Default",
      "inherits": "base"
    },
    {
      "name": "sanitizers",
      "displayName": "Sanitizers",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build-san",
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer"
      }
    },
    {
      "name": "coverage",
      "displayName": "Coverage",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build-cov",
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "--coverage",
        "CMAKE_EXE_LINKER_FLAGS": "--coverage"
      }
    },
    {
      "name": "analysis",
      "displayName": "Static Analysis",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "default",    "configurePreset": "default",    "jobs": 0 },
    { "name": "sanitizers", "configurePreset": "sanitizers", "jobs": 0 },
    { "name": "coverage",   "configurePreset": "coverage",   "jobs": 0 },
    { "name": "analysis",   "configurePreset": "analysis",   "jobs": 0 }
  ],
  "testPresets": [
    {
      "name": "default",
      "configurePreset": "default",
      "output": { "outputOnFailure": true },
      "execution": { "jobs": 0 }
    },
    {
      "name": "sanitizers",
      "configurePreset": "sanitizers",
      "output": { "outputOnFailure": true },
      "execution": { "jobs": 0 },
      "environment": {
        "ASAN_OPTIONS": "detect_leaks=1:halt_on_error=1",
        "UBSAN_OPTIONS": "halt_on_error=1:print_stacktrace=1"
      }
    },
    {
      "name": "coverage",
      "configurePreset": "coverage",
      "output": { "outputOnFailure": true },
      "execution": { "jobs": 0 }
    }
  ]
}